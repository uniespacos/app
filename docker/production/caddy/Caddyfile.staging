# Global options
{
    auto_https off
}

:80 {
    # Reverb WebSockets
    @reverb {
        path /app*
    }
    reverse_proxy @reverb reverb:9000 {
        header_up Host {http.request.host}
        header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
        header_up X-Forwarded-Proto {http.request.scheme}
    }
    root * /var/www/public
    php_fastcgi app:9000
    file_server
}
